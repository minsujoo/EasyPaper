{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EasyPaper",
  "version": "0.1.26",
  "identifier": "com.easypaper.desktop",
  "build": {
    "frontendDist": "loading-page"
  },
  "app": {
    "windows": [
      {
        "title": "EasyPaper",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#06050a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "binaries/easypaper-backend/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/minsujoo/EasyPaper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMzREOUZBMzE1MTYwQzgKUldUSVlGRXgrdGswbWtJUCtuWUNjcEk3NVl2K0dtV0UzVWh2SXlPWmt3YSs3UitOL1BBSDE3bnMK"
    }
  }
}
